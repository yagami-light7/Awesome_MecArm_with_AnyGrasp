# ============================================================
# Python cache
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# Virtual environments / conda / local env
# ============================================================
.venv/
venv/
env/
ENV/
conda_env/
*.egg-info/
build/
dist/

# ============================================================
# IDE / editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# If you want to share VSCode settings, use:
# .vscode/settings.example.json
# and keep real local settings ignored.

# ============================================================
# OS files
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# AnyGrasp SDK / closed-source / license / checkpoints
# ============================================================
third_party/anygrasp_sdk/

# If you want to keep a placeholder README in third_party:
!third_party/
!third_party/README.md

# Extra protection for AnyGrasp private/license files anywhere
license/
**/license/
*.lic
*.signature
*.public_key
licenseCfg.json
sample_license/

# AnyGrasp / model checkpoints / large model files
*.pth
*.pt
*.onnx
*.ckpt
*.tar
*.bin

# Compiled binary libraries
*.so
*.pyd
*.dll
*.dylib
*.a
*.o
*.obj

# CUDA / C++ extension build products
*.cu.o
*.cpp.o
*.egg-info/
**/build/
**/dist/

# ============================================================
# Generated captures / point cloud / runtime outputs
# ============================================================
captures/
outputs/
runs/
logs/
log/
tmp/
temp/

*.ply
*.pcd
*.npy
*.npz

# Images generated by camera capture / debug
# Keep this ignored unless you intentionally want sample images in repo.
*.png
*.jpg
*.jpeg
*.bmp
*.tiff

# If you need documentation images later, put them under docs/images/
!docs/
!docs/images/
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg

# ============================================================
# Local project status / runtime state
# ============================================================
project_status.json

# ============================================================
# ROS / Gazebo / CMake generated files
# ============================================================
install/
devel/
log/
.colcon/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# ============================================================
# Keep robot model source files
# ============================================================
# Do NOT ignore mec_arm_model/ by default.
# Your URDF, STL meshes, launch/config files are project assets.
# mec_arm_model/

.codex
.TimeRecord
